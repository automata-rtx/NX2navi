#version 450
// Refine the depth-reprojected field after reconstruction has consumed it. Each
// invocation owns a 4x4 tile. Search animated texture detail in the pre-HUD
// scene only where the camera vector fails, then check each pixel individually.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D currentColor;
layout(binding = 1) uniform sampler2D previousColor;
layout(binding = 2, rg16f) uniform image2D motion;
layout(binding = 3, r32f) uniform readonly image2D currentDepth;
layout(binding = 4, r32f) uniform readonly image2D previousDepth;
layout(push_constant) uniform P {
    vec2 size;
    vec2 jitterDelta;
}
pc;

vec3 value(sampler2D tex, vec2 p) { return sqrt(max(textureLod(tex, p / pc.size, 0).rgb, vec3(0))); }

const vec2 tap[9] =
    vec2[](vec2(0), vec2(-3, -2), vec2(3, 2), vec2(-2, 3), vec2(2, -3), vec2(-6, 0), vec2(6, 0), vec2(0, -6), vec2(0, 6));
float cost(sampler2D tex, vec3 reference[9], vec2 p) {
    float error = 0;
    for (int i = 0; i < 9; ++i)
        error += dot(abs(reference[i] - value(tex, p + tap[i])), vec3(.25, .5, .25));
    return error;
}

void main() {
    ivec2 tile = ivec2(gl_GlobalInvocationID.xy) * 4;
    ivec2 hi = ivec2(pc.size) - 1;
    if (any(greaterThan(tile, hi))) return;
    ivec2 center = min(tile + 2, hi);
    vec2 p = vec2(center) + .5;
    vec2 camera = imageLoad(motion, center).xy;
    vec2 origin = p + camera + pc.jitterDelta;
    if (any(lessThan(origin, vec2(42))) || any(greaterThan(origin, pc.size - 42))) return;
    float z = imageLoad(currentDepth, center).r;
    if (z <= 0) return;
    vec3 currentSamples[9];
    for (int i = 0; i < 9; ++i)
        currentSamples[i] = value(currentColor, p + tap[i]);
    float initial = cost(previousColor, currentSamples, origin);
    if (initial < .15) return;
    vec2 best = origin;
    float error = initial;
    for (int stepSize = 16; stepSize > 0; stepSize /= 2) {
        vec2 base = best;
        for (int y = -1; y <= 1; ++y)
            for (int x = -1; x <= 1; ++x) {
                if (x == 0 && y == 0) continue;
                vec2 q = base + vec2(x, y) * stepSize;
                float oldZ = imageLoad(previousDepth, ivec2(q)).r;
                if (abs(oldZ - z) > .06 * z) continue;
                float score = cost(previousColor, currentSamples, q);
                if (score < error) {
                    error = score;
                    best = q;
                }
            }
    }
    if (error > .5 * initial || length(best - origin) < 1.5) return;
    // A similar patch on a static surface can look convincing in one direction.
    // Reject it if the previous patch better matches the camera warp or a neighbour.
    vec3 previousSamples[9];
    for (int i = 0; i < 9; ++i)
        previousSamples[i] = value(previousColor, best + tap[i]);
    vec2 cameraBack = p + (best - origin);
    if (cost(currentColor, previousSamples, cameraBack) < error * 1.6) return;
    for (int y = -1; y <= 1; ++y)
        for (int x = -1; x <= 1; ++x) {
            if ((x != 0 || y != 0) && cost(currentColor, previousSamples, p + vec2(x, y) * 4) < error * .85) return;
        }
    vec2 vector = best - p - pc.jitterDelta;
    for (int y = 0; y < 4; ++y)
        for (int x = 0; x < 4; ++x) {
            ivec2 k = tile + ivec2(x, y);
            if (any(greaterThan(k, hi))) continue;
            vec2 here = vec2(k) + .5, there = here + vector + pc.jitterDelta;
            float depth = imageLoad(currentDepth, k).r;
            if (abs(depth - z) > .04 * z || abs(imageLoad(previousDepth, ivec2(there)).r - depth) > .06 * depth) continue;
            vec3 c = value(currentColor, here);
            vec2 old = here + imageLoad(motion, k).xy + pc.jitterDelta;
            float before = length(c - value(previousColor, old));
            if (length(c - value(previousColor, there)) + .005 < .75 * before) imageStore(motion, k, vec4(vector, 0, 0));
        }
}
