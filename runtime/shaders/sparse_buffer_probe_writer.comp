#version 450

layout(local_size_x = 64) in;
layout(set = 0, binding = 1, std430) buffer SparseData {
    uint words[];
} data;

void main()
{
    uint index = gl_GlobalInvocationID.x;
    uint prior = data.words[index];
    if ((prior & 31u) == 11u) {
        uint changed = (prior & 32u) != 0u ? prior : prior ^ 0x57a536c0u;
        data.words[index] = changed;
    }
}
